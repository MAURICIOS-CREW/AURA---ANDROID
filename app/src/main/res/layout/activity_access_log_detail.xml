<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_access_log_detail.xml

    Pantalla de detalle de un registro de acceso.
    Muestra toda la información del log:
      - Toolbar con back button y badge de status
      - Header con ícono, nombre del invitado, residencia
      - Sección de detalles: tipo, método, dispositivo, timestamp, código
      - Skeleton loader mientras carga
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_background">

    <!-- ══════════════════════════════════════
         APP BAR
         ══════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aura_white"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_button"
                android:foreground="?attr/selectableItemBackground"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/aura_text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:text="@string/access_log_detail_toolbar_title"
                android:textColor="@color/aura_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toStartOf="@id/tvToolbarStatus"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Badge de status en toolbar -->
            <TextView
                android:id="@+id/tvToolbarStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                tools:text="Permitido"
                tools:textColor="@color/aura_success"
                tools:background="@color/aura_success_light"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aura_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════
         CONTENIDO SCROLLABLE
         ══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── HERO CARD: ícono + nombre + residencia ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:id="@+id/heroIconContainer"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_icon_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/ivHeroIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/aura_primary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvHeroGuestName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/heroIconContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/heroIconContainer"
                    app:layout_constraintBottom_toTopOf="@id/tvHeroResidence"
                    tools:text="Juan Pérez (Invitado)" />

                <TextView
                    android:id="@+id/tvHeroResidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/aura_text_secondary"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:drawablePadding="4dp"
                    app:drawableStartCompat="@drawable/ic_lock"
                    app:drawableTint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toEndOf="@id/heroIconContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeroGuestName"
                    app:layout_constraintBottom_toBottomOf="@id/heroIconContainer"
                    tools:text="Casa 102 - Manzana A" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── SECCIÓN: INFORMACIÓN DEL EVENTO ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/access_log_detail_section_event"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/aura_text_tertiary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardInfoEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:layout_marginBottom="16dp">

                <!-- Fecha y hora -->
                <ImageView
                    android:id="@+id/icTimestamp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/rowTimestamp"
                    app:layout_constraintBottom_toBottomOf="@id/rowTimestamp"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/rowTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintStart_toEndOf="@id/icTimestamp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_log_detail_label_timestamp"
                        android:textSize="11sp"
                        android:textColor="@color/aura_text_tertiary" />

                    <TextView
                        android:id="@+id/tvDetailTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/aura_text_primary"
                        tools:text="05 ago 2026, 03:45 AM" />
                </LinearLayout>

                <View
                    android:id="@+id/divider1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/aura_divider"
                    app:layout_constraintStart_toEndOf="@id/icTimestamp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowTimestamp" />

                <!-- Tipo de acceso -->
                <ImageView
                    android:id="@+id/icAccessType"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/rowAccessType"
                    app:layout_constraintBottom_toBottomOf="@id/rowAccessType"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/rowAccessType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintStart_toEndOf="@id/icAccessType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_log_detail_label_access_type"
                        android:textSize="11sp"
                        android:textColor="@color/aura_text_tertiary" />

                    <TextView
                        android:id="@+id/tvDetailAccessType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/aura_text_primary"
                        tools:text="Código QR · Escaneo" />
                </LinearLayout>

                <View
                    android:id="@+id/divider2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/aura_divider"
                    app:layout_constraintStart_toEndOf="@id/icAccessType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowAccessType" />

                <!-- Dispositivo -->
                <ImageView
                    android:id="@+id/icDevice"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/rowDevice"
                    app:layout_constraintBottom_toBottomOf="@id/rowDevice"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/rowDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintStart_toEndOf="@id/icDevice"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_log_detail_label_device"
                        android:textSize="11sp"
                        android:textColor="@color/aura_text_tertiary" />

                    <TextView
                        android:id="@+id/tvDetailDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/aura_text_primary"
                        tools:text="GATE_NORTH_01" />
                </LinearLayout>

                <View
                    android:id="@+id/divider3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/aura_divider"
                    app:layout_constraintStart_toEndOf="@id/icDevice"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowDevice" />

                <!-- Mensaje del sistema -->
                <ImageView
                    android:id="@+id/icMessage"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/rowMessage"
                    app:layout_constraintBottom_toBottomOf="@id/rowMessage"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/rowMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    app:layout_constraintStart_toEndOf="@id/icMessage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider3"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_log_detail_label_message"
                        android:textSize="11sp"
                        android:textColor="@color/aura_text_tertiary" />

                    <TextView
                        android:id="@+id/tvDetailMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/aura_text_primary"
                        tools:text="Acceso permitido" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── SECCIÓN: CÓDIGO DE ACCESO ── -->
            <TextView
                android:id="@+id/tvSectionCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/access_log_detail_section_code"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/aura_text_tertiary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardInfoCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Nombre del invitado del código -->
                <ImageView
                    android:id="@+id/icCodeGuest"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_people"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/rowCodeGuest"
                    app:layout_constraintBottom_toBottomOf="@id/rowCodeGuest"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/rowCodeGuest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintStart_toEndOf="@id/icCodeGuest"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_log_detail_label_guest"
                        android:textSize="11sp"
                        android:textColor="@color/aura_text_tertiary" />

                    <TextView
                        android:id="@+id/tvDetailCodeGuest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/aura_text_primary"
                        tools:text="Juan Pérez (Invitado)" />
                </LinearLayout>

                <View
                    android:id="@+id/divider4"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/aura_divider"
                    app:layout_constraintStart_toEndOf="@id/icCodeGuest"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowCodeGuest" />

                <!-- Tipo de código -->
                <ImageView
                    android:id="@+id/icCodeType"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/rowCodeType"
                    app:layout_constraintBottom_toBottomOf="@id/rowCodeType"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:id="@+id/rowCodeType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    app:layout_constraintStart_toEndOf="@id/icCodeType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider4"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_log_detail_label_code_type"
                        android:textSize="11sp"
                        android:textColor="@color/aura_text_tertiary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tvDetailCodeType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/aura_text_primary"
                            tools:text="Personalizado" />

                        <TextView
                            android:id="@+id/tvDetailCodeActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            tools:text="Activo"
                            tools:textColor="@color/aura_success"
                            tools:background="@color/aura_success_light" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════
         SKELETON LOADER (superpuesto)
         ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutDetailSkeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_gravity="top"
        android:layout_marginTop="72dp"
        android:visibility="visible"
        tools:visibility="visible">

        <!-- Skeleton hero card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_dashboard_card"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_skeleton" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <View
                    android:layout_width="160dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="13dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>
        </LinearLayout>

        <!-- Skeleton section label -->
        <View
            android:layout_width="130dp"
            android:layout_height="13dp"
            android:background="@drawable/bg_skeleton"
            android:layout_marginBottom="10dp" />

        <!-- Skeleton info card (4 filas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card"
            android:padding="16dp">

            <View
                android:layout_width="200dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="150dp"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
