<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_background"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aura_white"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_button"
                android:foreground="?attr/selectableItemBackground"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/aura_text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/access_detail_toolbar_title"
                android:textColor="@color/aura_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toStartOf="@id/btnDelete"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_button"
                android:foreground="?attr/selectableItemBackground"
                android:padding="10dp"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="@color/aura_error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aura_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="20dp">

            <!-- ── CREATION BANNER ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutCreateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_dashboard_gradient"
                android:padding="24dp"
                android:elevation="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivCreateIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_security"
                    android:contentDescription="@string/cd_access_create_icon"
                    app:tint="@color/aura_white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvCreateTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/access_detail_banner_title"
                    android:textColor="@color/aura_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/ivCreateIcon"
                    app:layout_constraintBottom_toTopOf="@id/tvCreateDesc"
                    app:layout_constraintStart_toEndOf="@id/ivCreateIcon"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvCreateDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/access_detail_banner_desc"
                    android:textColor="@color/aura_overlay_white"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintTop_toBottomOf="@id/tvCreateTitle"
                    app:layout_constraintBottom_toBottomOf="@id/ivCreateIcon"
                    app:layout_constraintStart_toEndOf="@id/ivCreateIcon"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── QR SECTION ── -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardQrPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_dashboard_card"
                android:padding="24dp"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_qr_code"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvQrHash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/aura_text_primary"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/ivQrCode"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="X9T3P-8F2Q" />

                <TextView
                    android:id="@+id/tvQrStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:layout_constraintTop_toBottomOf="@id/tvQrHash"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Activo"
                    tools:textColor="@color/aura_success"
                    tools:background="@color/aura_success_light" />

                <LinearLayout
                    android:id="@+id/layoutQrNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/tvQrStatus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/ivNoticeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@string/cd_notice_icon"
                        app:tint="@color/aura_success" />

                    <TextView
                        android:id="@+id/tvNoticeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/aura_text_primary"
                        tools:text="Listo para funcionar y ser escaneado en caseta." />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ── ACTION BUTTONS ── -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnShare"
                    style="@style/Aura.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/access_detail_btn_share"
                    app:drawableStartCompat="@drawable/ic_people"
                    app:drawableTint="@color/aura_primary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEditMode"
                    style="@style/Aura.Button.Filled"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/access_detail_btn_edit" />
            </LinearLayout>

            <!-- ── FORM SECTION ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_detail_label_guest_name"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etGuestName"
                style="@style/Aura.Input"
                android:hint="@string/access_detail_hint_guest_name"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:layout_marginBottom="24dp" />

            <!-- Active Switch -->
            <LinearLayout
                android:id="@+id/layoutIsActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_detail_switch_enable"
                        android:textColor="@color/aura_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_detail_switch_enable_desc"
                        android:textColor="@color/aura_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchIsActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_detail_section_restrictions"
                android:textColor="@color/aura_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Límite de usos -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvUsesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_detail_uses_title"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivUsesInfo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="@string/cd_uses_info"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toEndOf="@id/tvUsesTitle"
                    app:layout_constraintTop_toTopOf="@id/tvUsesTitle"
                    app:layout_constraintBottom_toBottomOf="@id/tvUsesTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchUses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/layoutUsesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/switchUses">

                    <EditText
                        android:id="@+id/etMaxUses"
                        style="@style/Aura.Input"
                        android:hint="@string/access_detail_hint_max_uses"
                        android:inputType="number"
                        android:autofillHints="" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Rango de fechas -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDatesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_detail_dates_title"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivDatesInfo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="@string/cd_dates_info"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toEndOf="@id/tvDatesTitle"
                    app:layout_constraintTop_toTopOf="@id/tvDatesTitle"
                    app:layout_constraintBottom_toBottomOf="@id/tvDatesTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/layoutDatesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/switchDates">

                    <TextView
                        android:id="@+id/tvValidFrom"
                        style="@style/Aura.Input"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/access_detail_date_from"
                        android:textColor="@color/aura_text_secondary" />

                    <TextView
                        android:id="@+id/tvValidUntil"
                        style="@style/Aura.Input"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/access_detail_date_until"
                        android:textColor="@color/aura_text_secondary" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Días de la semana -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:padding="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDaysTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_detail_days_title"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivDaysInfo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="@string/cd_days_info"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toEndOf="@id/tvDaysTitle"
                    app:layout_constraintTop_toTopOf="@id/tvDaysTitle"
                    app:layout_constraintBottom_toBottomOf="@id/tvDaysTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/layoutDaysInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/switchDays">
                    
                    <CheckBox android:id="@+id/btnDay1" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_mon" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                    <CheckBox android:id="@+id/btnDay2" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_tue" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                    <CheckBox android:id="@+id/btnDay3" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_wed" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                    <CheckBox android:id="@+id/btnDay4" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_thu" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                    <CheckBox android:id="@+id/btnDay5" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_fri" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                    <CheckBox android:id="@+id/btnDay6" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_sat" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                    <CheckBox android:id="@+id/btnDay7" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_day_toggle" android:button="@null" android:gravity="center" android:text="@string/access_detail_day_sun" android:textColor="@color/aura_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_weight="1"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Horarios -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dashboard_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvHoursTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_detail_hours_title"
                    android:textColor="@color/aura_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivHoursInfo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="@string/cd_hours_info"
                    app:tint="@color/aura_text_tertiary"
                    app:layout_constraintStart_toEndOf="@id/tvHoursTitle"
                    app:layout_constraintTop_toTopOf="@id/tvHoursTitle"
                    app:layout_constraintBottom_toBottomOf="@id/tvHoursTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/layoutHoursInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/switchHours">

                    <TextView
                        android:id="@+id/tvStartTime"
                        style="@style/Aura.Input"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/access_detail_time_start"
                        android:textColor="@color/aura_text_secondary" />

                    <TextView
                        android:id="@+id/tvEndTime"
                        style="@style/Aura.Input"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/access_detail_time_end"
                        android:textColor="@color/aura_text_secondary" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
        
        <include
            android:id="@+id/layoutDetailSkeleton"
            layout="@layout/layout_detail_skeleton"
            android:visibility="gone" />

        <!-- Input Blocker Overlay -->
        <View
            android:id="@+id/viewInputBlocker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
            
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB & FAB Loader Container -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_detail_btn_save"
            android:textColor="@color/aura_white"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/aura_white"
            android:backgroundTint="@color/aura_primary"
            app:elevation="6dp" />

        <ProgressBar
            android:id="@+id/progressFab"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:elevation="10dp"
            android:indeterminateTint="@color/aura_white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Error Banner -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/errorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E53935"
        android:elevation="30dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivErrorBannerIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_warning"
            android:contentDescription="@string/cd_error_banner_icon"
            app:tint="@color/aura_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvErrorBannerMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/aura_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivErrorBannerIcon"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Ocurrió un error" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Success Banner -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/successBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/aura_success"
        android:elevation="30dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivSuccessBannerIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:contentDescription="@string/cd_success_banner_icon"
            app:tint="@color/aura_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSuccessBannerMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/aura_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivSuccessBannerIcon"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Operación exitosa" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
