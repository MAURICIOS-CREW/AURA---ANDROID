<?xml version="1.0" encoding="utf-8"?>
<!--
    layout_vehicle_form.xml
    
    Formulario reutilizable para crear/editar vehículos.
    Usa LinearLayout vertical para que los campos se apilen
    correctamente sin superposición.
    
    Puede incluirse con <include> en otros layouts o usarse
    como base para bottom sheets / fragmentos de formulario.
    
    IDs disponibles:
      - tvFormTitle   : Título del formulario (dinámico)
      - btnFormMinimize : Botón cerrar/minimizar
      - tilPlate / etPlate   : Placas (requerido)
      - tilBrand / etBrand   : Marca (opcional)  
      - tilColor / etColor   : Color (opcional)
      - btnSave    : Guardar
      - btnDelete  : Eliminar (oculto por defecto)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFormTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vehículo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/aura_text_primary" />

            <ImageView
                android:id="@+id/btnFormMinimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/aura_text_secondary"
                android:rotation="270" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="@color/aura_border_light" />

        <!-- ── Campo: Placas ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Placas *"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Campo: Marca ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Marca (Opcional)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Campo: Color ── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Color (Opcional)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Botón Guardar ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Guardar"
            android:textColor="@color/aura_white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/aura_primary"
            app:cornerRadius="12dp"
            app:rippleColor="@color/aura_ripple" />

        <!-- ── Botón Eliminar (oculto por defecto) ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Eliminar vehículo"
            android:textColor="@color/aura_error"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/aura_error_light"
            app:cornerRadius="12dp"
            app:rippleColor="#33E53E3E"
            app:strokeWidth="0dp" />

    </LinearLayout>

</ScrollView>
