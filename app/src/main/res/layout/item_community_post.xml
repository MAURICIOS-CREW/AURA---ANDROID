<?xml version="1.0" encoding="utf-8"?>
<com.mexadev.aura.ui.common.AuraCardBtn
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPost"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:isPureWhite="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aura_white"
        android:padding="16dp">

        <!-- Header: Avatar, Name, Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:id="@+id/ivAuthorAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_nav_profile_filled"
                android:contentDescription="@string/cd_author_avatar"
                app:tint="@color/aura_primary"
                android:background="@drawable/bg_circle_primary_light"
                android:padding="8dp"/>
                
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                
                <TextView
                    android:id="@+id/tvAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Nombre Autor"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/aura_text_primary" />
                    
                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Hace 2 horas"
                    android:textSize="12sp"
                    android:textColor="@color/aura_text_secondary"/>
            </LinearLayout>
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_community"
                android:contentDescription="@null"
                app:tint="@color/aura_text_tertiary" />
        </LinearLayout>

        <!-- Content -->
        <TextView
            android:id="@+id/tvPostContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            tools:text="Contenido del post..."
            android:textSize="15sp"
            android:textColor="@color/aura_text_primary"
            android:lineSpacingExtra="4dp"/>
            
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPostImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:src="@drawable/bg_residential_2" />
            
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aura_border_light"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>
            
        <!-- Actions: Like, Comment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            
            <LinearLayout
                android:id="@+id/btnLike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                
                <ImageView
                    android:id="@+id/ivLikeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="@string/cd_like"
                    app:tint="@color/aura_text_secondary" />
                    
                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/cd_like"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aura_text_secondary"/>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/btnComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                
                <ImageView
                    android:id="@+id/ivCommentIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_messages"
                    android:contentDescription="@string/cd_comment"
                    app:tint="@color/aura_text_secondary" />
                    
                <TextView
                    android:id="@+id/tvCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/cd_comment"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/aura_text_secondary"/>
            </LinearLayout>
            
        </LinearLayout>

    </LinearLayout>
</com.mexadev.aura.ui.common.AuraCardBtn>
