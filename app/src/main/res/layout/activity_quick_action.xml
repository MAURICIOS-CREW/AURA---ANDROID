<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_background">

    <!-- Header background shape -->
    <View
        android:id="@+id/vHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_quick_action_header"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextClock
        android:id="@+id/tcHeaderTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:format12Hour="hh:mm a"
        android:format24Hour="HH:mm"
        android:textColor="@color/aura_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivHeaderIcon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_circle_white"
        android:padding="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_aura_logo"
        android:elevation="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNotificationTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/quick_action_title_default"
        android:textAlignment="center"
        android:textColor="@color/aura_white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:elevation="8dp"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderIcon" />

    <TextView
        android:id="@+id/tvNotificationBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:text="@string/quick_action_body_default"
        android:textAlignment="center"
        android:textColor="#EAF0F6"
        android:textSize="15sp"
        android:elevation="8dp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNotificationTitle" />

    <!-- Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/aura_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/aura_border_light"
        app:layout_constraintBottom_toTopOf="@id/btnStartApp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNotificationBody">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:scrollbarStyle="outsideOverlay">

            <GridLayout
                android:id="@+id/glDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">
                <!-- Dynamic fields will be added here -->
            </GridLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartApp"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/quick_action_start_app"
        android:textAllCaps="false"
        android:textColor="@color/aura_white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/aura_primary"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnExit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExit"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/quick_action_exit"
        android:textAllCaps="false"
        android:textColor="@color/aura_text_secondary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/aura_surface_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Biometric Overlay (Glassmorphism look) -->
    <FrameLayout
        android:id="@+id/flBiometricOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6F5F7FA"
        android:elevation="20dp"
        android:translationZ="20dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_lock"
                android:background="@drawable/bg_circle_primary_light"
                android:padding="24dp"
                android:elevation="8dp"
                app:tint="@color/aura_primary"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/quick_action_unlock_prompt"
                android:textColor="@color/aura_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvRetryBiometric"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/quick_action_retry_biometric"
                android:textColor="@color/aura_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
