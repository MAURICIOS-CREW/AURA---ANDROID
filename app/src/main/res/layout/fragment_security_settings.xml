<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/securitySettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_background"
    android:elevation="30dp"
    android:translationZ="30dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Encabezado con botón de regreso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_back_button"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/cd_back"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/settings_security"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

    <com.mexadev.aura.ui.common.AuraCardBtn
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardClickAnimationEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/aura_white"
            android:orientation="vertical"
            android:padding="16dp">
            
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/security_fingerprint"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingVertical="12dp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginVertical="4dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchLockOnExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/security_lock_on_exit"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingVertical="12dp" />
                
        </LinearLayout>
    </com.mexadev.aura.ui.common.AuraCardBtn>

    <com.mexadev.aura.ui.common.AuraCardBtn
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:isPureWhite="false"
        app:cardBackgroundColor="@color/aura_info">
        
        <TextView
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/aura_info"
            android:text="@string/security_change_password"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/aura_text_on_primary"
            android:padding="20dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            app:drawableEndCompat="@drawable/ic_arrow_right"
            app:drawableTint="@color/aura_text_on_primary"/>

    </com.mexadev.aura.ui.common.AuraCardBtn>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
