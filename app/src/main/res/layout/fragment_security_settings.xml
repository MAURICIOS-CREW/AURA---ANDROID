<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_security"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchFingerprint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/security_fingerprint"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurface"
        android:paddingVertical="16dp" />
        
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchLockOnExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/security_lock_on_exit"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurface"
        android:paddingVertical="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:id="@+id/btnChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/security_change_password"
        android:textSize="18sp"
        android:textColor="?attr/colorPrimary"
        android:paddingVertical="20dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
