<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_dashboard_card"
    android:elevation="1dp"
    android:padding="16dp">

    <View
        android:id="@+id/skIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skStatus"
        android:layout_width="70dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/skIcon" />

    <View
        android:id="@+id/skTitle"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintEnd_toStartOf="@id/skStatus"
        app:layout_constraintStart_toEndOf="@id/skIcon"
        app:layout_constraintTop_toTopOf="@id/skIcon" />

    <View
        android:id="@+id/skDate"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skIcon"
        app:layout_constraintTop_toBottomOf="@id/skTitle" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierSkeletonHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="skIcon,skDate" />

    <View
        android:id="@+id/skBtn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierSkeletonHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
