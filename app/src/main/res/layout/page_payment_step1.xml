<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payments_form_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/aura_text_primary" />

    <TextView
        android:id="@+id/tvFormAmountHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Total a pagar: $2,700.00 MXN"
        android:textSize="14sp"
        android:textColor="@color/aura_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/aura_border_light"
        android:layout_marginVertical="16dp" />

    <!-- Segmented Payment Tabs -->
    <com.mexadev.aura.ui.common.AuraSegmentedControl
        android:id="@+id/segmentedControlPayment"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp" />

    <!-- ViewPager2 for Stripe / Transfer panels -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpPaymentPanels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never" />

    <!-- Submit Button Container with ProgressBar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitPayment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/payments_form_confirm_pay"
            android:textColor="@color/aura_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_btn_primary" />

        <ProgressBar
            android:id="@+id/pbSubmitLoading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/aura_white"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
