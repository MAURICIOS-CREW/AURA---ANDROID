<?xml version="1.0" encoding="utf-8"?>
<com.mexadev.aura.ui.common.AuraCardBtn
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPaymentHistory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:isPureWhite="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@color/aura_white"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCheckIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_check_circle"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/layoutTextGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/ivCheckIcon"
            app:layout_constraintEnd_toStartOf="@id/layoutAmountGroup"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvPaymentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Mayo 2026"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/aura_text_primary"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvPaymentSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Pagado • Stripe"
                android:textSize="12sp"
                android:textColor="@color/aura_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAmountGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvPaymentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="$1,250.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/aura_text_primary" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/bg_pill_success"
                tools:text="Pagado"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/aura_success" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.mexadev.aura.ui.common.AuraCardBtn>
