<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_background"
    android:elevation="20dp"
    android:clickable="true"
    android:focusable="true">

    <!-- AppBar Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aura_white"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_button"
                android:foreground="?attr/selectableItemBackground"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back"
                app:tint="@color/aura_text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDetailIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_community"
                android:contentDescription="@null"
                app:tint="@color/aura_primary"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/community_title"
                android:textColor="@color/aura_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivDetailIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aura_divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content & Comments -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <!-- Shared Element Card Container -->
            <com.mexadev.aura.ui.common.AuraCardBtn
                android:id="@+id/cardPostDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:isPureWhite="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header: Avatar, Name, Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivAuthorAvatar"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_nav_profile_filled"
                            android:contentDescription="@string/cd_author_avatar"
                            app:tint="@color/aura_primary"
                            android:background="@drawable/bg_circle_primary_light"
                            android:padding="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvAuthorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Nombre Autor"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/aura_text_primary" />

                            <TextView
                                android:id="@+id/tvTimestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Hace 2 horas"
                                android:textSize="12sp"
                                android:textColor="@color/aura_text_secondary"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Content -->
                    <TextView
                        android:id="@+id/tvPostContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        tools:text="Contenido del post..."
                        android:textSize="16sp"
                        android:textColor="@color/aura_text_primary"
                        android:lineSpacingExtra="4dp"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPostImage"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="14dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                        tools:src="@drawable/bg_residential_2" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/aura_border_light"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Actions: Like, Comment Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:id="@+id/btnLike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_rounded_gray">

                            <ImageView
                                android:id="@+id/ivLikeIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_heart"
                                android:contentDescription="@string/cd_like"
                                app:tint="@color/aura_text_secondary" />

                            <TextView
                                android:id="@+id/tvLikeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                tools:text="0 Me gusta"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/aura_text_secondary"/>
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/tvCommentCountHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="0 Comentarios"
                            android:textSize="13sp"
                            android:textColor="@color/aura_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.mexadev.aura.ui.common.AuraCardBtn>

            <!-- Comments Section Header -->
            <TextView
                android:id="@+id/tvCommentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="@string/community_title"
                android:textColor="@color/aura_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Comments List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_comment" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Add Comment Bar -->
    <LinearLayout
        android:id="@+id/layoutInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/aura_white"
        android:elevation="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aura_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/etCommentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:maxLines="4"
                android:inputType="textCapSentences|textMultiLine"
                android:importantForAutofill="no"
                android:background="@drawable/bg_rounded_gray"
                android:hint="@string/incident_add_comment_hint"
                android:textColorHint="@color/aura_text_tertiary"
                android:textColor="@color/aura_text_primary"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSendComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:fabCustomSize="44dp"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/cd_send"
                app:tint="@color/aura_white"
                app:backgroundTint="@color/aura_primary"
                app:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
