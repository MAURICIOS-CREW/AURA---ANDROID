<?xml version="1.0" encoding="utf-8"?>
<!--
    item_access_log_skeleton.xml
    Skeleton loader del item de historial de accesos.
    Sigue el mismo layout que item_access_log para transición fluida.
-->
<com.mexadev.aura.ui.common.AuraCardBtn
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardClickAnimationEnabled="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/aura_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Ícono skeleton -->
        <View
            android:id="@+id/skeletonIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Timestamp skeleton (esquina derecha) -->
        <View
            android:id="@+id/skeletonTimestamp"
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/skeletonIcon"
            app:layout_constraintBottom_toTopOf="@id/skeletonMeta" />

        <!-- Título skeleton -->
        <View
            android:id="@+id/skeletonTitle"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintStart_toEndOf="@id/skeletonIcon"
            app:layout_constraintEnd_toStartOf="@id/skeletonTimestamp"
            app:layout_constraintTop_toTopOf="@id/skeletonIcon"
            app:layout_constraintBottom_toTopOf="@id/skeletonMeta" />

        <!-- Meta skeleton (badge + residencia) -->
        <View
            android:id="@+id/skeletonMeta"
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_skeleton"
            app:layout_constraintStart_toEndOf="@id/skeletonIcon"
            app:layout_constraintTop_toBottomOf="@id/skeletonTitle"
            app:layout_constraintBottom_toBottomOf="@id/skeletonIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.mexadev.aura.ui.common.AuraCardBtn>
